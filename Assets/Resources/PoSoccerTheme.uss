/*
 * PoSoccer design system.
 *
 * Replaces 223 inline `.style.` assignments spread across Agent_HUD and
 * Agent_MainMenu, which is why padding and type sizes had drifted apart between
 * the two screens - there was no shared definition for them to drift from.
 *
 * Units are in the PanelSettings reference space: 1080 x 1920, ScaleWithScreenSize
 * matching WIDTH. So 1 unit here is 1/1080th of the screen width on any device.
 * (Agent_UIStyle's docstring used to claim 1170 x 2532; that was never true.)
 *
 * Dynamic values stay in C#: per-profile player colours, meter widths and team
 * tints are data, not design, and belong with the code that computes them.
 */

:root {
/* UNITS ARE LOAD-BEARING. These were unitless (e.g. `--font-s: 38;`) and every
   rule that read them through var() silently failed: `font-size: var(--font-s)`
   could not parse a bare number as a length, so it fell back to UI Toolkit's
   ~12 px default. Colours resolved fine, which is why the UI looked styled but
   every class-driven size - the menu title, subtitle, pitch note, SND toggle,
   .btn, chip badges - rendered as fine print. Only inline `.style.fontSize`
   assignments were ever the right size. Verified on device 2026-08-29.
   Do not remove the px suffixes. */

    /* Palette */
    --color-bg: rgb(13, 23, 18);
    --color-panel: rgba(0, 0, 0, 0.45);
    --color-panel-solid: rgb(18, 26, 22);
    --color-scrim: rgba(0, 0, 0, 0.78);
    --color-text: rgb(255, 255, 255);
    --color-text-muted: rgb(179, 191, 184);
    --color-team-blue: rgb(51, 128, 255);
    --color-team-red: rgb(255, 64, 51);
    --color-accent: rgb(41, 140, 71);
    --color-gold: rgb(255, 214, 51);
    --color-edge-light: rgba(255, 255, 255, 0.16);
    --color-edge-dark: rgba(0, 0, 0, 0.35);

    /* Spacing scale - every margin and padding in the game comes from here */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;

    /* Minimum tappable edge. Android's guidance is 48dp; on a 1080 px portrait
       phone at ~420 dpi that is ~126 px, and the PanelSettings reference is
       1080-wide match-WIDTH, so 120 px here is ~7.6 mm of real glass. Agent_Chrome
       had this constant in C# and enforced it on two buttons; every other button
       in the game was smaller (presets 74, steppers 86, roster 78, and the HUD
       sound/pause pair measured 80.75 live on 2026-09-06 - about 5.1 mm). One
       token, applied to .btn, so the policy cannot hold in one screen and not the
       other. Do not shrink these to make a layout fit; take the space from margins. */
    --touch-min: 120px;

    /* Radii */
    --radius-sm: 8px;
    --radius-md: 16px;
    --radius-lg: 24px;

    /* Type scale */
    /* Sizes are grounded in Android's type scale, not taste. PanelSettings is
       ScaleWithScreenSize at a 1080-wide reference matching WIDTH, so on a
       1080 px portrait phone one UI pixel is one physical pixel. Material's
       floors therefore convert directly:
         12sp caption ~ 34 px      14sp body ~ 39 px      16sp subtitle ~ 45 px
       --font-xs was 24 (~0.7 mm cap height) and --font-s was 30, both under the
       12sp floor, which is why the roster cards, chip driver tags, pitch note
       and every .btn read as fine print on a phone and fine on a monitor. */
    --font-xs: 34px;
    --font-s: 38px;
    --font-m: 44px;
    --font-l: 64px;
    --font-xl: 120px;
    --font-display: 118px;
}

/* ---------------------------------------------------------------- layout - */

.screen {
    flex-grow: 1;
    justify-content: space-between;
}

.screen--menu {
    background-color: var(--color-bg);
    align-items: center;
    justify-content: space-evenly;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
}

.band {
    align-items: center;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    padding-left: var(--space-5);
    padding-right: var(--space-5);
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.stack-center {
    align-items: center;
}

/* ------------------------------------------------------------ typography - */

.text-muted {
    color: var(--color-text-muted);
    font-size: var(--font-s);
}

.score {
    font-size: var(--font-l);
    -unity-font-style: bold;
    color: var(--color-text);
}

.clock {
    font-size: var(--font-s);
    color: var(--color-text-muted);
}

.title {
    font-size: var(--font-display);
    -unity-font-style: bold;
    color: var(--color-text);
}

/* --------------------------------------------------------------- surface - */

/*
 * Elevation without box-shadow, which UI Toolkit does not support: a light top
 * edge and a dark bottom edge read as a lifted surface against the pitch.
 */
.panel {
    background-color: var(--color-panel);
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
    border-top-width: 1;
    border-bottom-width: 2;
    border-top-color: var(--color-edge-light);
    border-bottom-color: var(--color-edge-dark);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    padding-left: var(--space-5);
    padding-right: var(--space-5);
}

.panel--scrim {
    background-color: var(--color-scrim);
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-bottom-width: 0;
    /*
     * Fails VISIBLE on purpose. The end panel is raised while the clock is
     * frozen; if transitions ever failed to run, an `opacity: 0` default would
     * leave the player staring at a dead pitch with no result and no buttons.
     * So the resting state is shown, and `is-entering` - added on creation and
     * removed one frame later - supplies the animation.
     */
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.22s, 0.22s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.panel--scrim.is-entering {
    opacity: 0;
    scale: 0.96 0.96;
}

/* --------------------------------------------------------------- buttons - */

.btn {
    font-size: var(--font-s);
    min-height: var(--touch-min);
    justify-content: center;
    color: var(--color-text);
    background-color: var(--color-panel);
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
    border-top-width: 1;
    border-bottom-width: 2;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: var(--color-edge-light);
    border-bottom-color: var(--color-edge-dark);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out;
}

/* States the previous inline styling could not express at all. */
.btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.btn:active {
    scale: 0.96 0.96;
    background-color: rgba(255, 255, 255, 0.22);
}

.btn:disabled {
    opacity: 0.4;
}

.btn--primary {
    background-color: var(--color-accent);
    -unity-font-style: bold;
    font-size: var(--font-m);
    padding-left: var(--space-7);
    padding-right: var(--space-7);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    margin-top: var(--space-4);
}

.btn--primary:hover {
    background-color: rgb(56, 173, 92);
}

.btn--play {
    font-size: 74;
    -unity-font-style: bold;
    background-color: var(--color-accent);
    padding-left: 150;
    padding-right: 150;
    padding-top: 26;
    padding-bottom: 26;
}

.btn--ghost {
    background-color: var(--color-panel);
    margin-top: var(--space-4);
    padding-left: var(--space-7);
    padding-right: var(--space-7);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    font-size: var(--font-m);
    -unity-font-style: bold;
}

.btn--roster {
    height: var(--touch-min);
    font-size: var(--font-s);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    padding-left: 26;
    padding-right: 26;
    margin-left: var(--space-1);
    margin-right: var(--space-1);
}

/* ------------------------------------------------------------------ hud - */

.chip {
    align-items: center;
    margin-left: 10;
    margin-right: 10;
}

.chip__badge {
    width: 84;
    height: 84;
    -unity-text-align: middle-center;
    font-size: var(--font-m);
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    border-bottom-left-radius: var(--radius-sm);
    border-bottom-right-radius: var(--radius-sm);
    border-bottom-width: 6;
}

.chip__driver {
    font-size: var(--font-xs);
    margin-top: var(--space-1);
    -unity-font-style: bold;
}

.meter {
    flex-direction: row;
    width: 600;
    height: 14;
    margin-bottom: var(--space-4);
    background-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 7;
    border-top-right-radius: 7;
    border-bottom-left-radius: 7;
    border-bottom-right-radius: 7;
}

.meter__fill {
    height: 14;
    transition-property: width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.meter__fill--blue {
    background-color: var(--color-team-blue);
    border-top-left-radius: 7;
    border-bottom-left-radius: 7;
}

.meter__fill--red {
    background-color: var(--color-team-red);
    border-top-right-radius: 7;
    border-bottom-right-radius: 7;
}

/* ------------------------------------------------- win probability strip - */

/* Narrower and flatter than the ball-control meter directly below it, because
   the two must never be confused: this one is a MODEL and that one is a
   measurement. Transition duration is long on purpose - the estimate is already
   smoothed in C#, and a bar that twitches reads as noise rather than tension. */
.winprob {
    flex-direction: row;
    width: 640;
    height: 8;
    margin-top: var(--space-3);
    background-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 4;
    border-top-right-radius: 4;
    border-bottom-left-radius: 4;
    border-bottom-right-radius: 4;
    overflow: hidden;
}

.winprob__fill {
    height: 8;
    transition-property: width;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.winprob__fill--blue {
    background-color: var(--color-team-blue);
}

.winprob__fill--red {
    background-color: var(--color-team-red);
}

.winprob__label {
    margin-top: var(--space-1);
    font-size: var(--font-xs);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    letter-spacing: 2;
}

/* ---------------------------------------------------------- stat ticker - */

/* Sits above the ball-control meter in the bottom band. Muted and small: it is
   colour on the match, never information the viewer has to act on. */
.ticker {
    margin-bottom: var(--space-3);
    font-size: var(--font-xs);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 1;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.ticker.is-shown {
    opacity: 1;
}

/* -------------------------------------------------------- broadcast bug - */

/* Mirrors .replay-tag's position and rhythm, on the opposite edge, so the two
   status marks read as one system rather than two people's ideas. */
.broadcast-tag {
    position: absolute;
    right: var(--space-7);
    top: 14%;
    font-size: var(--font-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--color-text-muted);
    letter-spacing: 2;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.broadcast-tag.is-shown {
    opacity: 1;
}

/*
 * Structural rules for Resources/HUD.uxml. These exist so the UXML carries no
 * inline `style=` at all: the whole point of extracting the template was to end
 * up with one place that decides how the HUD looks, and a template full of
 * inline styles is the imperative version with angle brackets.
 */
.hud__chip-row {
    justify-content: space-between;
    /* Wide enough to seat a 2v2 chip set at each end without collision at the
       1080 reference width, narrow enough to stay clear of the safe-area inset. */
    width: 900;
}

.hud__controls {
    margin-top: var(--space-3);
}

/* The two letterbox bars differ only in which edge they pin to; that is
   structure, so it belongs here rather than in two style assignments in C#. */
.letterbox--top {
    top: 0;
}

.letterbox--bottom {
    bottom: 0;
}

/* ------------------------------------------------------------ broadcast - */

/*
 * The callout lanes. Each animates scale and opacity so a goal punches in
 * instead of appearing, which is most of what separates a HUD from a
 * broadcast package.
 */
.toast {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    -unity-text-align: middle-center;
    font-size: var(--font-xl);
    -unity-font-style: bold;
    color: var(--color-text);
    opacity: 0;
    scale: 0.7 0.7;
    transition-property: opacity, scale;
    transition-duration: 0.18s, 0.18s;
    transition-timing-function: ease-out, ease-out-back;
}

.toast.is-shown {
    opacity: 1;
    scale: 1 1;
}

.commentary {
    position: absolute;
    left: var(--space-6);
    right: var(--space-6);
    top: 52%;
    -unity-text-align: middle-center;
    font-size: var(--font-m);
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
    opacity: 0;
    translate: 0 12px;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out;
}

.commentary.is-shown {
    opacity: 1;
    translate: 0 0;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 24%;
    -unity-text-align: middle-center;
    font-size: var(--font-m);
    -unity-font-style: bold;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.banner.is-shown {
    opacity: 1;
}

.letterbox {
    position: absolute;
    left: 0;
    right: 0;
    height: 11%;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.letterbox.is-shown {
    opacity: 1;
}

.replay-tag {
    position: absolute;
    left: var(--space-7);
    top: 14%;
    font-size: var(--font-m);
    -unity-font-style: bold;
    color: var(--color-team-red);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.replay-tag.is-shown {
    opacity: 1;
}

/* ------------------------------------------------------------ telemetry - */

.telemetry {
    position: absolute;
    top: 140;
    left: 20;
    padding-top: 14;
    padding-bottom: 14;
    padding-left: 18;
    padding-right: 18;
    background-color: rgba(0, 0, 0, 0.72);
    color: rgb(166, 255, 179);
    /* 26 was a desktop-only size. Agent_Chrome's DEBUG button makes this panel
       reachable on a phone, so it has to clear the same 12sp floor as the rest.
       ~15 rows at 34 px is ~630 px of a 1920 px screen - height is not a
       constraint here. */
    font-size: 34;
    -unity-font-style: bold;
    white-space: normal;
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    border-bottom-left-radius: var(--radius-sm);
    border-bottom-right-radius: var(--radius-sm);
}

/* --------------------------------------------------------------- motion - */

/*
 * Staged entrance for menu rows. The C# adds .enter-from, then clears it a
 * frame later, and the transition does the rest.
 */
.enter {
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.enter-from {
    opacity: 0;
    translate: 0 28px;
}

/* ------------------------------------------------------------ roster card - */

/*
 * The player card (Agent_PlayerCard). Portrait, 1080 reference width, so the
 * card is 980 with the scrim's 50 px of breathing room either side.
 *
 * Every size here clears the 12sp legibility floor the font scale documents
 * above: the smallest text on this card is the tile caption at 30 px, which is
 * the same size the roster slot cards use for their driver line and was
 * verified readable on device.
 */
.card {
    width: 980;
    background-color: var(--color-panel-solid);
    border-top-left-radius: var(--radius-lg);
    border-top-right-radius: var(--radius-lg);
    border-bottom-left-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
    border-top-width: 1;
    border-bottom-width: 2;
    border-top-color: var(--color-edge-light);
    border-bottom-color: var(--color-edge-dark);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    padding-left: var(--space-6);
    padding-right: var(--space-6);
    align-items: stretch;
}

.card__band {
    height: 12;
    margin-bottom: var(--space-4);
    border-top-left-radius: 6;
    border-top-right-radius: 6;
    border-bottom-left-radius: 6;
    border-bottom-right-radius: 6;
}

.card__name {
    font-size: var(--font-l);
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-left;
}

.card__driver {
    font-size: var(--font-xs);
    -unity-font-style: bold;
    margin-bottom: var(--space-4);
}

/* Three tiles across 916 px of inner width: 300 each leaves 8 px of gap. */
.card__tiles {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: var(--space-4);
}

.card__tile {
    width: 300;
    background-color: var(--color-panel);
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    border-bottom-left-radius: var(--radius-sm);
    border-bottom-right-radius: var(--radius-sm);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    align-items: center;
}

.card__tile-value {
    font-size: var(--font-m);
    -unity-font-style: bold;
    color: var(--color-gold);
}

.card__tile-label {
    font-size: 30;
    color: var(--color-text-muted);
    -unity-font-style: bold;
    margin-top: var(--space-1);
}

/*
 * The caption wraps to as many lines as it needs. It carries the sample size
 * behind a win rate, so clipping it would remove exactly the qualifier that
 * stops a percentage being over-read.
 */
.card__tile-caption {
    font-size: 30;
    color: var(--color-text-muted);
    opacity: 0.75;
    white-space: normal;
    -unity-text-align: upper-center;
    margin-top: var(--space-2);
}

.card__note {
    font-size: var(--font-xs);
    color: var(--color-text-muted);
    white-space: normal;
    margin-bottom: var(--space-4);
}

.card__heading {
    font-size: 30;
    -unity-font-style: bold;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
}

.card__prov {
    font-size: 30;
    color: var(--color-text-muted);
    opacity: 0.7;
    white-space: normal;
    margin-top: var(--space-4);
}

/* ------------------------------------------------------ attribute bars - */

.attr {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

.attr__label {
    width: 260;
    font-size: var(--font-xs);
    -unity-font-style: bold;
    color: var(--color-text);
}

.attr__track {
    flex-grow: 1;
    height: 22;
    background-color: rgba(255, 255, 255, 0.14);
    border-top-left-radius: 11;
    border-top-right-radius: 11;
    border-bottom-left-radius: 11;
    border-bottom-right-radius: 11;
    overflow: hidden;
}

/*
 * The fill sweeps out from zero. Agent_PlayerCard sets width 0 and then the
 * real percentage one frame later, so this transition always has something to
 * animate from - a card is rebuilt on every page, so its bars are new elements
 * that would otherwise just appear at their final width.
 */
.attr__fill {
    height: 22;
    border-top-left-radius: 11;
    border-top-right-radius: 11;
    border-bottom-left-radius: 11;
    border-bottom-right-radius: 11;
    transition-property: width;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}

.attr__value {
    width: 90;
    font-size: var(--font-xs);
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-right;
}

/* -------------------------------------------------------- card chrome - */

.card-nav {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: var(--space-4);
}

.card-nav__arrow {
    width: 110;
    height: 96;
    font-size: var(--font-m);
}

/* Two lines: the page position, then the live squad counts. Wrapping has to
   be enabled explicitly or the newline is collapsed and the counts vanish. */
.card-nav__count {
    width: 320;
    font-size: var(--font-xs);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

.card-add {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-3);
}

.card-add__btn {
    -unity-font-style: bold;
    margin-left: var(--space-2);
    margin-right: var(--space-2);
}

/* ============================================================== typeface = */

/*
 * The project shipped with NO font asset at all: every label in the menu, the
 * HUD, the player card and the telemetry overlay rendered in UI Toolkit's
 * built-in default. That default is a UI font, not a display one, and at the
 * --font-xl scoreline size its proportions are the single most "unfinished"
 * thing on the screen.
 *
 * Two families, both SIL Open Font Licence (the licence text ships beside them
 * in Resources/Fonts/, which is what the OFL requires of a redistribution):
 *
 *   Inter  - the body face. Designed for screens at small sizes, which is
 *            exactly the 34-44 px band this UI lives in on a 1080-wide phone.
 *   Oswald - the display face. Condensed, so a long roster name and a two-digit
 *            scoreline both fit a fixed-width slot, and it carries the
 *            broadcast-scoreboard association this game's whole presentation
 *            layer is aiming at.
 *
 * -unity-font-definition INHERITS, so declaring the body face on :root reaches
 * every element in every panel; only the display lanes below have to opt out.
 * Both files are variable fonts. Unity renders them at their default instance
 * and synthesises `-unity-font-style: bold`, which is what the previous default
 * font did too - so bold looks the same kind of bold it always did.
 */

:root {
    -unity-font-definition: resource("Fonts/Inter");
}

/* Display lanes. Everything that is a NUMBER, a NAME or a SHOUT - the things a
   viewer reads at a glance from across a room - and nothing that is prose. */
.title,
.score,
.toast,
.banner,
.btn--play,
.chip__badge,
.card__name,
.card__tile-value,
.ticker,
.winprob__label,
.replay-tag,
.broadcast-tag,
.menu__team-name,
.menu__count,
.slot__name {
    -unity-font-definition: resource("Fonts/Oswald");
}

/* ========================================================= accessibility = */

/*
 * Two axes, both stored in PlayerPrefs by Agent_Palette and both applied as ONE
 * class on the panel root by Agent_UIStyle.ApplyAccessibility.
 *
 * They work by redefining the stylesheet's own variables rather than by
 * restyling elements. USS custom properties inherit, so a class on the root
 * reaches every `var(--color-team-blue)` and `var(--font-s)` already written
 * below - no rule here has to know which elements exist, and a lane added later
 * is covered for free. The C# side reads the same enum for the things USS
 * cannot reach: sprite tints, Light2D colours, the player rim materials.
 */

/* Okabe-Ito blue/orange. Red against blue is the most common confusion axis
   there is, and this game asks the viewer to separate two teams at phone size,
   in motion, on a green pitch. These two hold their hue difference under
   protanopia, deuteranopia and tritanopia alike. */
.palette--safe {
    --color-team-blue: rgb(0, 114, 178);
    --color-team-red: rgb(230, 159, 0);
}

/* Separated in LUMINANCE as well as hue, so the pair survives greyscale, glare
   and a cheap panel - and so does a screenshot of it. */
.palette--contrast {
    --color-team-blue: rgb(41, 107, 255);
    --color-team-red: rgb(255, 194, 15);
    --color-panel: rgba(0, 0, 0, 0.82);
    --color-panel-solid: rgb(6, 10, 8);
    --color-text-muted: rgb(226, 233, 229);
    --color-edge-light: rgba(255, 255, 255, 0.4);
}

/* Type steps. ~1.18x and ~1.4x on the body sizes; the display sizes grow more
   slowly because --font-xl is already 120 px and a 1.4x scoreline would not fit
   the band it sits in. Every value keeps the px unit for the reason the header
   of this file records at length. */
.type--lg {
    --font-xs: 40px;
    --font-s: 45px;
    --font-m: 52px;
    --font-l: 72px;
    --font-xl: 132px;
}

.type--xl {
    --font-xs: 48px;
    --font-s: 53px;
    --font-m: 60px;
    --font-l: 80px;
    --font-xl: 142px;
}

/* ============================================================ main menu = */

/*
 * Structural rules for Resources/Menu.uxml, in the same spirit as the .hud__*
 * block above: the template carries no inline `style=` at all, so this is the
 * only place that decides how the menu looks.
 *
 * Sizes come from the previous imperative version verbatim where they were
 * already deliberate (the 1000 px section width, the 78 px roster button, the
 * 86 px stepper) - the point of the extraction was to stop the drift, not to
 * redesign the screen underneath the player.
 */

.menu__presets {
    flex-direction: row;
    justify-content: center;
    margin-bottom: var(--space-5);
}

.menu__preset {
    -unity-font-style: bold;
    padding-left: 30;
    padding-right: 30;
    margin-left: 5;
    margin-right: 5;
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    border-bottom-left-radius: var(--radius-sm);
    border-bottom-right-radius: var(--radius-sm);
}

.menu__section {
    align-items: center;
    width: 1000;
}

.menu__band {
    height: 8;
    width: 340;
    margin-bottom: var(--space-3);
    border-top-left-radius: 4;
    border-top-right-radius: 4;
    border-bottom-left-radius: 4;
    border-bottom-right-radius: 4;
}

/* The team colours come from the palette variables, so the colour-vision modes
   reach the menu bands and team names without a line of C#. */
.menu__band--blue { background-color: var(--color-team-blue); }
.menu__band--red { background-color: var(--color-team-red); }

.menu__team-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}

.menu__team-name {
    font-size: 52px;
    -unity-font-style: bold;
    margin-right: 26;
}

.menu__team-name--blue { color: var(--color-team-blue); }
.menu__team-name--red { color: var(--color-team-red); }

.menu__stepper {
    width: var(--touch-min);
    height: var(--touch-min);
    font-size: 54px;
    -unity-font-style: bold;
    padding-left: 0;
    padding-right: 0;
    border-top-left-radius: 14;
    border-top-right-radius: 14;
    border-bottom-left-radius: 14;
    border-bottom-right-radius: 14;
}

.menu__count {
    font-size: 48px;
    -unity-font-style: bold;
    color: var(--color-text);
    width: 120;
    -unity-text-align: middle-center;
}

.menu__roster {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 1000;
    margin-bottom: var(--space-2);
}

.menu__strip {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 1000;
    min-height: 190;
}

.menu__note {
    margin-bottom: var(--space-4);
}

.menu__options {
    margin-top: 18;
}

.menu__settings {
    margin-top: var(--space-3);
}

.menu__hint {
    margin-top: var(--space-3);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.menu__hint.is-shown {
    opacity: 1;
}

.menu__empty {
    font-size: var(--font-xs);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    margin-top: 34;
}

/* ------------------------------------------------------------ squad slot - */

/*
 * One filled squad position. Built in C# because the count is data, styled here
 * because the look is not. `.slot--compact` is the >5-a-side variant: the card
 * narrows and the step count is dropped rather than every line shrinking below
 * the 12sp legibility floor the type scale documents.
 */
.slot {
    width: 250;
    height: 174;
    margin-left: 5;
    margin-right: 5;
    margin-bottom: var(--space-2);
    padding-top: 4;
    padding-bottom: 4;
    padding-left: 2;
    padding-right: 2;
    align-items: center;
    justify-content: center;
    border-top-width: 3;
    border-bottom-width: 3;
    border-left-width: 3;
    border-right-width: 3;
}

.slot--compact {
    width: 182;
    height: 150;
}

.slot--blue {
    border-top-color: var(--color-team-blue);
    border-bottom-color: var(--color-team-blue);
    border-left-color: var(--color-team-blue);
    border-right-color: var(--color-team-blue);
}

.slot--red {
    border-top-color: var(--color-team-red);
    border-bottom-color: var(--color-team-red);
    border-left-color: var(--color-team-red);
    border-right-color: var(--color-team-red);
}

/* Black on the profile colour, which is always a light tint - the roster is
   authored that way and Agent_EditMode_Palette pins it. */
.slot__name {
    font-size: var(--font-m);
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.slot__driver {
    font-size: var(--font-xs);
    color: rgb(0, 0, 0);
    opacity: 0.8;
    -unity-text-align: middle-center;
}

.slot__steps {
    font-size: var(--font-xs);
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    opacity: 0.85;
    -unity-text-align: middle-center;
}

.slot--compact .slot__name { font-size: var(--font-xs); }
.slot--compact .slot__driver { font-size: 30px; }

/* --------------------------------------------------------- roster button - */

.menu__pick {
    height: 78;
    font-size: var(--font-s);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    padding-left: 26;
    padding-right: 26;
    margin-left: var(--space-1);
    margin-right: var(--space-1);
    border-top-width: 2;
    border-bottom-width: 2;
    border-left-width: 2;
    border-right-width: 2;
    border-top-left-radius: 12;
    border-top-right-radius: 12;
    border-bottom-left-radius: 12;
    border-bottom-right-radius: 12;
}

.menu__pick--blue {
    border-top-color: var(--color-team-blue);
    border-bottom-color: var(--color-team-blue);
    border-left-color: var(--color-team-blue);
    border-right-color: var(--color-team-blue);
}

.menu__pick--red {
    border-top-color: var(--color-team-red);
    border-bottom-color: var(--color-team-red);
    border-left-color: var(--color-team-red);
    border-right-color: var(--color-team-red);
}
