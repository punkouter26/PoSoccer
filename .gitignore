# =========================================
# Unity generated
# =========================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store tools
/[Aa]ssets/AssetStoreTools*

# MCP tool screenshots
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# ML-Agents runtime timer dumps
/[Aa]ssets/ML-Agents/
/[Aa]ssets/ML-Agents.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code caches
.vs/
.idea/
.consulo/
*.csproj
*.slnx
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports / builds
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / StreamingAssets packed content
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# =========================================
# ML-Agents / Training artifacts
# =========================================
# Training results, checkpoints, TensorBoard event files
/results/
/summaries/
/models/
*.ckpt
*.pt
run_logs/

# Keep trained .onnx files that live under Assets (GUID-pinned models ARE tracked)
# (no ignore rule for Assets/**/*.onnx on purpose)

# Local clone of ml-agents source (installed as local UPM package)
/ml-agents/

# Local tool clones (Claude skills / MCP sources)
/.tooling/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secondary venv (see setup-training-env.ps1 fallback to .venv2)
.venv2/

# =========================================
# OS
# =========================================
.DS_Store
Thumbs.db
desktop.ini

# =========================================
# Secrets / local env
# =========================================
.env
*.local.json
!.claude/settings.local.json

# Claude Code session scratch
/.claude/state/

# =========================================
# Unity test runner transient artifacts
# =========================================
# PerformanceTestRunInfo.json + PerformanceTestRunSettings.json are written by
# the Test Runner before every play-mode run and hold the test filter / stdout
# capture config, not project state. Regenerated on demand.
/[Aa]ssets/Resources/PerformanceTestRun*.json
/[Aa]ssets/Resources/PerformanceTestRun*.json.meta

# =========================================
# Android/CMake build scratch written by the Gradle NDK step during AAB/APK
# builds (configure fingerprints, .cmake API query+reply, compile_commands).
# Regenerated on every build and machine-specific, so it churned as a modified
# file in every git status. Untracked 2026-08-04.
/.utmp/
