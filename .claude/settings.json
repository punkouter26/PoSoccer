      "mcp__unity-coplay__find_in_file",
      "mcp__unity-coplay__get_sha",
      "mcp__unity-coplay__get_test_job",
      "mcp__unity-coplay__unity_docs",
      "mcp__unity-coplay__unity_reflect",
      "mcp__unity-coplay__validate_script",
      "mcp__unity-coplay__debug_request_context",

      "mcp__unity-anklebreaker__unity_editor_ping",
      "mcp__unity-anklebreaker__unity_editor_state",
      "mcp__unity-anklebreaker__unity_get_compilation_errors",
      "mcp__unity-anklebreaker__unity_get_project_context",
      "mcp__unity-anklebreaker__unity_project_info",
      "mcp__unity-anklebreaker__unity_scene_info",
      "mcp__unity-anklebreaker__unity_scene_hierarchy",
      "mcp__unity-anklebreaker__unity_scene_stats",
      "mcp__unity-anklebreaker__unity_gameobject_info",
      "mcp__unity-anklebreaker__unity_prefab_info",
      "mcp__unity-anklebreaker__unity_component_get_properties",
      "mcp__unity-anklebreaker__unity_component_get_referenceable",
      "mcp__unity-anklebreaker__unity_asset_list",
      "mcp__unity-anklebreaker__unity_search_assets",
      "mcp__unity-anklebreaker__unity_search_by_component",
      "mcp__unity-anklebreaker__unity_search_by_layer",
      "mcp__unity-anklebreaker__unity_search_by_name",
      "mcp__unity-anklebreaker__unity_search_by_tag",
      "mcp__unity-anklebreaker__unity_search_missing_references",
      "mcp__unity-anklebreaker__unity_selection_get",
      "mcp__unity-anklebreaker__unity_selection_find_by_type",
      "mcp__unity-anklebreaker__unity_packages_list",
      "mcp__unity-anklebreaker__unity_packages_info",
      "mcp__unity-anklebreaker__unity_packages_search",
      "mcp__unity-anklebreaker__unity_hub_list_editors",
      "mcp__unity-anklebreaker__unity_hub_available_releases",
      "mcp__unity-anklebreaker__unity_hub_get_install_path",
      "mcp__unity-anklebreaker__unity_list_instances",
      "mcp__unity-anklebreaker__unity_list_advanced_tools",
