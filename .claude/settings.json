      "mcp__unity-anklebreaker__unity_agent_log",
      "mcp__unity-anklebreaker__unity_queue_info",
      "mcp__unity-anklebreaker__unity_script_read",
      "mcp__unity-anklebreaker__unity_undo_history",

      "mcp__unity-ozankasikci__ping",
      "mcp__unity-ozankasikci__get_editor_state",
      "mcp__unity-ozankasikci__get_scene_info",
      "mcp__unity-ozankasikci__get_hierarchy",
      "mcp__unity-ozankasikci__get_gameobject_details",
      "mcp__unity-ozankasikci__get_component_values",
      "mcp__unity-ozankasikci__get_component_types",
      "mcp__unity-ozankasikci__get_object_references",
      "mcp__unity-ozankasikci__get_compilation_state",
      "mcp__unity-ozankasikci__get_ui_element_state",
      "mcp__unity-ozankasikci__list_components",
      "mcp__unity-ozankasikci__list_scenes",
      "mcp__unity-ozankasikci__list_scripts",
      "mcp__unity-ozankasikci__find_gameobject",
      "mcp__unity-ozankasikci__find_by_component",
      "mcp__unity-ozankasikci__find_ui_elements",
      "mcp__unity-ozankasikci__read_logs",
      "mcp__unity-ozankasikci__enhanced_read_logs",
      "mcp__unity-ozankasikci__read_script",
      "mcp__unity-ozankasikci__analyze_scene_contents",
      "mcp__unity-ozankasikci__analyze_asset_dependencies",
      "mcp__unity-ozankasikci__analyze_screenshot",
      "mcp__unity-ozankasikci__validate_script",

      "mcp__unity-codergamester__get_console_logs",
      "mcp__unity-codergamester__get_gameobject",
      "mcp__unity-codergamester__get_material_info",
      "mcp__unity-codergamester__get_play_mode_status",
      "mcp__unity-codergamester__get_scene_info",
      "mcp__unity-codergamester__get_scenes_hierarchy"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-scene-edit.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-meta-edit.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/guard-editor-runtime.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/gateguard.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/guard-project-config.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-projectsettings.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/bash-gate.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/track-reads.sh",
            "timeout": 2000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/warn-serialization.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-filename.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": ".claude/hooks/warn-platform-defines.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/quality-gate.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/track-edits.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": ".claude/hooks/suggest-verify.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-commit.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": ".claude/hooks/build-analyze.sh",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/cost-tracker.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": ".claude/hooks/instinct-capture.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-compact.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-restore.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-validate.sh",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": ".claude/hooks/session-save.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": ".claude/hooks/auto-learn.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": ".claude/hooks/instinct-distill.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": ".claude/hooks/notify.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
